# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI (Whisper)
OPENAI_API_KEY=your_openai_api_key

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# SendGrid (Email)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=edgelands@yourdomain.com

# App Configuration
NEXT_PUBLIC_APP_URL=https://your-app-url.vercel.app

# User ID (temporary - until auth is implemented)
DEFAULT_USER_ID=your_user_id_from_supabase

# Cron Secret (for securing cron endpoints)
CRON_SECRET=your_random_secret_string

# Gmail OAuth (for Correspondent Agent)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable Gmail API and configure OAuth consent screen
GMAIL_CLIENT_ID=your_gmail_oauth_client_id
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret
